+def _fmt_value(v):
+    """A value as the deck prints it: whole numbers from 1,000, else 1 dp."""
+    return f"{v:,.0f}" if abs(v) >= 1000 else f"{v:,.1f}"
+
+
+def _headline_policy(pl, kw, head):
+    """Indicative deck, but the client GAVE the Global headline figures: those
+    - and what follows from them by the basic formulas - stay readable.
+
+    Open: the 2025 / 2026 / 2036 values, the absolute opportunity (2026->2036
+    and 2025->2036), the 2036/2026 multiple ("1.6X increase") and the forecast
+    CAGR, wherever they are written: a KPI card, a table's TOTAL row, a chart
+    bar labelled with the forecast span, a sentence.  The CAGR, which many
+    cells can round to, is read only where its own context says it is the
+    Global forecast CAGR (a 'Global ...' page / a sentence without a region or
+    country name).  Every region / country / segment figure, and the 2021-2025
+    CAGR, is withheld as usual."""
+    v25, v26, v36 = (head.get(k) for k in ("value_2025", "value_2026",
+                                           "value_2036"))
+    nums = {_fmt_value(v) for v in (v25, v26, v36) if v}
+    if v26 and v36:
+        nums.add(_fmt_value(v36 - v26))
+        if v25:
+            nums.add(_fmt_value(v36 - v25))
+    cagr = f"{head['cagr'] * 100:.1f}%"
+    mult = set()
+    for base in (v26, v25):          # 2026->2036 and the classic 2025->2036
+        if base and v36:
+            mult |= {f"{v36 / base:.1f}", f"{v36 / base:.2f}"}
+    span = {f"{config.EST_YEAR}-{config.END_YEAR}",
+            f"{config.EST_YEAR}–{config.END_YEAR}"}
+    geos = {str(g).lower() for g in data.REGIONS}
+    for cs in data.COUNTRIES.values():
+        geos |= {str(c).lower() for c in cs}
+    geos.discard("global")
+
+    def _geo_free(s):
+        low = s.lower()
+        return not any(g in low for g in geos)
+
+    class HeadlinePolicy(pl.LockPolicy):
+        global_slides = set()
+
+        def is_open_label(self, text):
+            if super().is_open_label(text):
+                return True
+            # a chart category / column named for the forecast span, on a
+            # 'Global ...' page: the given CAGR and the 2026->2036 increment
+            t = str(text or "").strip().replace(" ", "")
+            if t in span:
+                f = sys._getframe(1).f_locals
+                return f.get("slide_no") in self.global_slides
+            return False
+
+        def keeps_value(self, v):
+            """A chart point whose value IS a given / derived headline
+            figure (the 2026 and 2036 bars, the 2026->2036 increment)."""
+            try:
+                return _fmt_value(float(v)) in nums
+            except (TypeError, ValueError):
+                return False
+
+        def keeps_figure(self, s, a, b, whole):
+            m = re.search(r"\d[\d,]*(?:\.\d+)?", whole)
+            if not m:
+                return False
+            num = m.group(0)
+            if num in nums:
+                return True
+            if num in mult and _geo_free(s) and "market" in s.lower()                     and not re.search(r"volume|units?|MT|segment|higher|"
+                                      r"lower|compared", s, re.I) and (
+                    s[b:b + 1] in ("X", "x")
+                    or whole.rstrip().endswith(("X", "x"))):
+                return True
+            if whole.strip().endswith("%") and num + "%" == cagr:
+                # major places only: the Global market / forecast CAGR
+                # sentence - never a named category or a ranked statement
+                return (_geo_free(s) and re.search(
+                    r"global|forecast cagr", s, re.I) is not None
+                    and not re.search(r"['’]|segment|fastest|highest|"
+                                      r"lowest|leads?|largest|outpac",
+                                      s, re.I))
+            return False
+
+        def is_protected(self, text):
+            if super().is_protected(text):
+                return True
+            t = " ".join(str(text or "").split())
+            if t in nums:
+                return True
+            if t == cagr:
+                f = sys._getframe(1).f_locals
+                if "total_rows" in f:                      # a table cell
+                    return (f.get("slide_no") in self.global_slides
+                            and f.get("r") in f["total_rows"])
+                return f.get("n") in self.global_slides    # a KPI card
+            return False
+
+    return HeadlinePolicy(**kw)
+
